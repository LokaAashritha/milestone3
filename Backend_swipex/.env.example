# -----------------------------------------------------------------------------
# Job Swipe Backend - Environment Configuration
# Copy this file to ".env" and fill in real values before running the app.
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://swipex:swipex_dev_pass@localhost:5432/swipex_gateway

# JWT configuration
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed origins, "*" for all
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App metadata
APP_NAME=Job Swipe Gateway API
APP_ENV=development
