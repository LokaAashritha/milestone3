# Environment configuration for SwipeX Job & Data Intelligence Service
PROJECT_NAME="SwipeX - Job & Data Intelligence Service"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (Defaults to SQLite dev file)
DATABASE_URL="sqlite:///./swipex_dev.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://swipex_user:swipex_pass@localhost:5432/swipex_db"

# Redis Cache (Falls back to in-memory cache if not available)
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=True
CACHE_TTL_SECONDS=300

# File Storage Configuration
UPLOAD_DIR="./uploads/resumes"
MAX_RESUME_SIZE_MB=10
